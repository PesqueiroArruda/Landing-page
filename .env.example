# Copie este arquivo para .env.local e preencha com valores reais.
# Nunca commitar .env.local (já está no .gitignore).

# --- Supabase (server-only) ---
# Project Settings > API, no painel do Supabase
SUPABASE_URL=
# Service role key (secreta! ignora RLS, nunca expor ao client)
SUPABASE_SERVICE_ROLE_KEY=

# --- InfinitePay (Checkout Integrado) ---
# Sua InfiniteTag, sem o símbolo $ (ex: se a tag é $pesqueiroarrudas, use apenas "pesqueiroarrudas")
INFINITEPAY_HANDLE=

# --- Resend (server-only) ---
RESEND_API_KEY=
# Remetente verificado no Resend (domínio próprio verificado, ou onboarding@resend.dev em teste)
RESEND_FROM_EMAIL="Pesqueiro Arruda's <onboarding@resend.dev>"
# Destinatário da notificação de nova reserva paga
RESERVATION_NOTIFICATION_EMAIL=arrudadiego45@gmail.com

# --- Backend principal (cardápio digital) ---
# API do sistema administrativo (Product/Estoque) — consultada em GET /menu,
# rota pública. Server-only, não precisa de NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:8080

# --- App ---
# Usada para montar redirect_url/webhook_url do checkout. Em produção, use a URL pública do site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: sobrescreve o valor do sinal (padrão 5000 = R$50,00) para testar
# o checkout pagando um valor baixo de verdade, já que a InfinitePay não tem
# sandbox. Ex: 100 = R$1,00. NÃO defina isso em produção.
# NEXT_PUBLIC_RESERVATION_DEPOSIT_CENTS=100
